import {MosaicImageInfo} from "../canvas/canvas.type.js";

/** 通用响应结构 */
export interface LiveRoomResponse {
  /** 返回值 0: 成功 1: 不存在 */
  code: number;

  /** 错误信息 */
  message: string;

  /** 错误信息 */
  msg: string;

  /** 信息本体 */
  data: LiveRoomRespBody;
}

/** 信息本体 */
export interface LiveRoomRespBody {
  /** 主播 mid */
  uid: number;

  /** 直播间长号 */
  room_id: number;

  /** 直播间短号, 为0是无短号 */
  short_id: number;

  /** 关注数量 */
  attention: number;

  /** 观看人数 */
  online: number;

  /** 是否竖屏 */
  is_portrait: boolean;

  /** 描述 */
  description: string;

  /** 直播状态 0: 未开播 1: 直播中 2: 轮播中 */
  live_status: number;

  /** 分区 id */
  area_id: number;

  /** 父分区 id */
  parent_area_id: number;

  /** 父分区名称 */
  parent_area_name: string;

  /** 旧版分区 id */
  old_area_id: number;

  /** 背景图片链接 */
  background: string;

  /** 标题 */
  title: string;

  /** 封面 */
  user_cover: string;

  /** 关键帧, 用于网页端悬浮展示 */
  keyframe: string;

  /** 未知 */
  is_strict_room: boolean;

  /** 直播开始时间, YYYY-MM-DD HH:mm:ss */
  live_time: string;

  /** 标签, ',' 分隔 */
  tags: string;

  /** 未知 */
  is_anchor: number;

  /** 禁言状态 */
  room_silent_type: string;

  /** 禁言等级 */
  room_silent_level: number;

  /** 禁言时间, 单位是秒 */
  room_silent_second: number;

  /** 分区名称 */
  area_name: string;

  /** 未知 */
  pardants: string;

  /** 未知 */
  area_pardants: string;

  /** 热词 */
  hot_words: string[];

  /** 热词状态 */
  hot_words_status: number;

  /** 未知 */
  verify: string;

  /** 头像框、大V */
  new_pendants: NewPendants;

  /** 未知 */
  up_session: string;

  /** pk 状态 */
  pk_status: number;

  /** pk id */
  pk_id: number;

  /** 未知 */
  battle_id: number;

  /** 允许换分区时间 */
  allow_change_area_time: number;

  /** 允许上传封面时间 */
  allow_upload_cover_time: number;

  /** 演播室信息 */
  studio_info: StudioInfo;
}

/** 头像框、大V */
export interface NewPendants {
  /** 头像框 */
  frame: Frame | null;

  /** 手机版头像框, 结构一致, 可能 null */
  mobile_frame: Frame | null;

  /** 大V */
  badge: Badge | null;

  /** 手机版大V, 结构一致, 可能 null */
  mobile_badge: Badge | null;
}

/** 头像框 */
export interface Frame {
  /** 名称 */
  name: string;

  /** 值 */
  value: string;

  /** 位置 */
  position: number;

  /** 描述 */
  desc: string;

  /** 分区 */
  area: number;

  /** 旧分区 */
  area_old: number;

  /** 背景色 */
  bg_color: string;

  /** 背景图 */
  bg_pic: string;

  /** 是否旧分区号 */
  use_old_area: boolean;
}

/** 大V */
export interface Badge {
  /** 类型 v_person: 个人认证(黄) v_company: 企业认证(蓝) */
  name: string;

  /** 位置 */
  position: number;

  /** 值 */
  value: string;

  /** 描述 */
  desc: string;
}

/** 演播室信息 */
export interface StudioInfo {
  /** 状态 */
  status: number;

  /** 主播列表 */
  master_list: any[]; // 表格里没有详细结构，先用 any[]
}

/** 根对象 */
export interface LiveRoomsResponse {
  /** 返回值 0: 成功 -400: 请求错误 */
  code: number;

  /** 错误信息, 默认为 0 */
  message: string;

  /** 固定为 1 */
  ttl: number;

  /** 信息本体 */
  data: LiveRoomsRespData;
}

/** 信息本体 */
export interface LiveRoomsRespData {
  /** 空对象 */
  by_uids: Record<string, unknown>;

  /** 直播间信息, 键为直播间长ID, 按键名降序排序 */
  by_room_ids: Record<string, RoomInfo>;
}

/** 直播间信息 */
export interface RoomInfo {
  /** 直播间长ID */
  room_id: number;

  /** 主播用户 mid */
  uid: number;

  /** 直播间分区 ID */
  area_id: number;

  /** 直播状态 0: 未开播 1: 直播中 2: 轮播中 */
  live_status: number;

  /** 直播间网页 url */
  live_url: string;

  /** 直播间父分区 ID */
  parent_area_id: number;

  /** 直播间标题 */
  title: string;

  /** 直播间父分区名称 */
  parent_area_name: string;

  /** 直播间分区名称 */
  area_name: string;

  /** 开播时间, yyyy-MM-dd HH:mm:ss */
  live_time: string;

  /** 直播间简介 */
  description: string;

  /** 直播间标签, 以 ',' 分隔 */
  tags: string;

  /** 关注数 */
  attention: number;

  /** 在线人数 */
  online: number;

  /** 直播间短ID, 为0是无短号 */
  short_id: number;

  /** 主播用户名 */
  uname: string;

  /** 直播间封面 url */
  cover: string;

  /** 直播间背景 url */
  background: string;

  /** join_slide, 未知, 一般为 1 */
  join_slide: number;

  /** live_id, 未知, 一般为 0 */
  live_id: number;

  /** live_id_str, 一般为 "0" */
  live_id_str: string;
}

export type LinkType = "opus" | "t" | "video";

/**
 * 链接转换负载
 */
export interface LinkPayload {
  // 链接解析的类型; opus: 图文动态; t: t动态
  type: LinkType;
  // 对应的 ID
  id: string;
  // 原始 URL
  rawUrl: string;
  // 附加内容
  extend?: Record<string, any>;
}

/**
 * 动态信息转换负载
 */
export interface DynamicPayload {
  // 动态类型
  type: LinkType;
  // 动态 ID
  id: string;

  // 动态发送时间, 时间戳, 毫秒级
  pubAt: number;

  // 发布者 ID
  authorId: number;
  // 发布者名
  authorName: string;
  // 发布者头像 URL
  authorAvatarURL: string;

  // 动态标题
  title?: string;

  // 动态内容
  text: string;

  // 动态内图片列表 URL
  imagesInfo?: MosaicImageInfo[];
  // 动态内图片总和尺寸
  imagesTotalSize: number;

  // 动态内视频列表 URL
  videosURL?: string[];
  // 动态内视频总和尺寸
  videosTotalSize: number;

  // 点赞 / 转发 / 评论数量
  likesAmount: number;
  forwardsAmount: number;
  commentsAmount: number;
}

/**
 * 视频信息转换负载
 */
export interface VideoicPayload {
  // 视频 bvID
  bvid: string;

  // 视频 cID
  cid: number;

  // 视频分类; <tname> · <tname_v2>
  category: string;

  // 视频标题
  title: string;

  // 视频简介
  desc: string;

  // 封面图链接
  coverURL: string;

  // 发布者信息
  authorName: string;
  authorId: number;
  authorAvatarURL: string;

  // 视频投递时间, 时间戳, 毫秒级
  pubAt: number;

  // 视频总时长
  duration: number;

  // 浏览 / 喜欢 / 投币 / 收藏数量
  viewAmount: number;
  likeAmount: number;
  coinAmount: number;
  favAmount: number;
}

/**
 * 视频信息解析请求参数
 */
export interface ParseToVideoicParams {
  // 后处理: 获取视频快照吗？
  postFetchSnapshot?: boolean;
  // 视频快照最多获取多少帧；默认：5f
  snapshotMaxFrames?: number;

  // 后处理: 生成视频速览吗？
  postGeneratePreview?: boolean;
  // 视频速览最长长度; 默认：60s
  previewMaxDuration?: number;
}

/**
 * 视频基本信息请求负载
 */
export interface VideoInfoParams {
  bvid?: string;
  aid?: number;
}

export interface VideoSnapshotParams extends VideoInfoParams {
  // 分P ID, 默认 1P
  cid?: number;
  // 是否获取json数组截取时间表; 1: 需要, 0: 不需要
  index?: number;
}

export interface VideoDownloadParams extends VideoInfoParams {
  cid: number;
  gaia_source?: string;
  qn?: number;
  fnval?: number;
  fnver?: 0;
  fourk?: 0 | 1;
  session?: string;
  otype?: "json";
  type?: string;
  platform?: "pc" | "html5";
  high_quality?: 0 | 1;
  try_look?: number;
}

export interface UserInfoCardParams {
  mid: string;
}

export interface UserInfoCardPayload {
  code: number;
  message: string;
  ttl: number;
  data: {
    card: UserCard;
    following: boolean;
    archive_count: number;
    article_count: number;
    follower: number;
    like_num: number;
  };
}

export interface UserCard {
  mid: string;
  name: string;
  approve: boolean;
  sex: string;
  rank: string;
  face: string;

  face_nft: number;
  face_nft_type: number;
  DisplayRank: string;

  regtime: number;
  spacesta: number;
  birthday: string;
  place: string;
  description: string;

  article: number;
  attentions: unknown[];

  fans: number;
  friend: number;
  attention: number;
  sign: string;

  is_senior_member: number;
  name_render: null;
}

export interface UserBasicSearchPayload {
  code: number;
  message: string;
  ttl: number;
  data: {
    uid_list: UserBasicSearchItem[];
  };
}

export interface UserBasicSearchItem {
  name: string;
  uid: string;
}
